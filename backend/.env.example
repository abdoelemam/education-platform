# ================================
# Application
# ================================
NODE_ENV=development
PORT=5000

# ================================
# Database
# ================================
MONGODB_URI=mongodb://127.0.0.1:27017/education-platform

# ================================
# CORS
# ================================
CORS_ORIGIN=http://localhost:3000

# ================================
# Logging
# ================================
LOG_LEVEL=debug

# ================================
# Authentication & JWT
# ================================
# Replace these with strong, randomly generated secrets (min 32 characters)
JWT_ACCESS_SECRET=your_jwt_access_secret_min_32_characters_long_example
JWT_REFRESH_SECRET=your_jwt_refresh_secret_min_32_characters_long_example
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ================================
# Cookie Configuration
# ================================
COOKIE_SAME_SITE=lax
# COOKIE_DOMAIN=localhost

# ================================
# Future: Payment Provider
# ================================
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=

# ================================
# Future: Video Storage
# ================================
# VIDEO_PROVIDER=cloudinary
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
