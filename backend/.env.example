# ================================
# Application
# ================================
NODE_ENV=development
PORT=5000

# ================================
# Database
# ================================
MONGODB_URI=mongodb://127.0.0.1:27017/education-platform

# ================================
# CORS
# ================================
CORS_ORIGIN=http://localhost:3000

# ================================
# Logging
# ================================
LOG_LEVEL=debug

# ================================
# Authentication & JWT
# ================================
# Replace these with strong, randomly generated secrets (min 32 characters)
JWT_ACCESS_SECRET=your_jwt_access_secret_min_32_characters_long_example
JWT_REFRESH_SECRET=your_jwt_refresh_secret_min_32_characters_long_example
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ================================
# Cookie Configuration
# ================================
COOKIE_SAME_SITE=lax
# COOKIE_DOMAIN=localhost

# ================================
# Future: Payment Provider
# ================================
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=

# ================================
# Video Storage Provider
#
# Videos are uploaded directly from the browser to the provider using
# short-lived signed instructions. The API server never proxies video bytes.
# With VIDEO_PROVIDER=unconfigured (default) upload authorization fails closed
# with HTTP 503 instead of faking a successful upload.
# ================================
VIDEO_PROVIDER=unconfigured
# VIDEO_PROVIDER=cloudinary
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
# Provider asset folder (server-chosen public id prefix)
VIDEO_UPLOAD_FOLDER=education-platform/videos
# Note: Cloudinary enforces a fixed 1-hour validity window on signed upload
# instructions (the signature timestamp must be within one hour of the upload).
# It cannot be shortened, so there is no TTL configuration.
